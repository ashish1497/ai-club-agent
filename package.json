{
  "name": "ai-club-agent",
  "version": "0.1.0",
  "private": true,
  "description": "AI Club thinking agent: Claude Code kit (constitution, skills, templates, installers) and open domain-pack library.",
  "type": "module",
  "author": {
    "name": "Ashish Bajaj",
    "email": "ashish_bajaj@pg27.mesaschool.co",
    "url": "https://sudosquad.club"
  },
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "kit:test": "cd club-agent && python3 -m unittest discover -s tests",
    "site:test": "npm --prefix site test",
    "test": "npm run kit:test && npm run site:test",
    "site:dev": "npm --prefix site run dev",
    "site:build": "npm --prefix site run build",
    "check": "npm run format:check && npm run lint && npm test",
    "site:e2e": "npm --prefix site run e2e",
    "verify": "npm run check && npm run site:build && npm run site:test && npm run site:e2e"
  },
  "lint-staged": {
    "*.{md,js,mjs,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,yml,yaml,css}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.3",
    "@next/eslint-plugin-next": "^16.4.5",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.1"
  }
}
