# What: Optional build-time settings for the problem site. Copy to site/.env.local for local builds if you want non-default values.
# How: Read by site/src/config.ts at build time; in CI they come from GitHub repository variables instead.
# Objective: Make the two configurable URLs obvious without requiring any env file to build.
NEXT_PUBLIC_SITE_URL=https://ai-club-problems.vercel.app
NEXT_PUBLIC_KIT_REPO_URL=https://github.com/REPLACE-ME/ai-club-agent
